<resources>

    <color name="dark_30_percent">#4D000000</color>
    <color name="dark_50_percent">#80000000</color>
    <color name="dark_70_percent">#B3000000</color>

    <color name="system_window_scrim_light">#99FFFFFF</color>
    <color name="system_window_scrim_dark">#66202124</color>
    <color name="system_window_scrim">@color/system_window_scrim_light</color>

    <color name="system_window_scrim_light_compat">#44000000</color>
    <color name="system_window_scrim_compat">@color/system_window_scrim_light_compat</color>

    <color name="system_window_scrim_dark_black">#66000000</color>
    <!-- Make lint happy, although actually we never use this in a non-night configuration. -->
    <color name="color_primary_dark_black">@android:color/transparent</color>

    <color name="color_primary_light">@color/google_blue_600</color>
    <color name="color_primary_dark">@color/google_blue_300</color>
    <color name="color_primary">@color/color_primary_light</color>

    <color name="color_surface_light">@android:color/white</color>
    <color name="color_surface_dark">@color/google_grey_900</color>
    <color name="color_surface">@color/color_surface_light</color>

    <!-- Outline color for the MD2 theme (MD3 has it built in). ~12% black on light
         surface / ~12% white on dark surface, matching Material 3's colorOutline. -->
    <color name="color_outline_light">#1F000000</color>
    <color name="color_outline_dark">#14FFFFFF</color>
    <color name="color_outline">@color/color_outline_light</color>

    <color name="activity_icon_tint">@color/secondary_text_default_material_light</color>

    <color name="shortcut_icon_background">#F5F5F5</color>

    <color name="file_icon_light_blue">#4B86F0</color>
    <color name="file_icon_blue">#4285F4</color>
    <color name="file_icon_cyan">#24C1E0</color>
    <color name="file_icon_light_green">#34A853</color>
    <color name="file_icon_green">#22A667</color>
    <color name="file_icon_deep_green">#0F9D58</color>
    <color name="file_icon_grey">#5F6368</color>
    <color name="file_icon_orange">#FD7541</color>
    <color name="file_icon_purple">#A142F4</color>
    <color name="file_icon_red">#EA4335</color>
    <color name="file_icon_deep_red">#DB4437</color>
    <color name="file_icon_yellow">#F4B400</color>

    <!-- Terminal extra-keys toolbar: semi-transparent dark so terminal text shows
         through, like Termux's toolbar. -->
    <color name="terminal_toolbar_background">#CC000000</color>
    <!-- Extra-key text: light grey normally, accent-teal when pressed/activated. -->
    <color name="terminal_key_text_normal">#B3FFFFFF</color>
    <color name="terminal_key_text_activated">#80DEEA</color>
</resources>
