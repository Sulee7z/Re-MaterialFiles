<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!--
      ~ MT Manager style two-pane browsing. Fixed ids so FragmentManager can restore the two
      ~ FileListFragments across Activity recreation. Widths are set in code (no layout
      ~ weights): DrawerLayout (the FileListFragment root) crashes when a weight-based
      ~ LinearLayout measures it with AT_MOST.
      -->
    <FrameLayout
        android:id="@+id/leftPane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        tools:ignore="Suspicious0dp" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="?attr/colorOutline" />

    <FrameLayout
        android:id="@+id/rightPane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        tools:ignore="Suspicious0dp" />
</LinearLayout>
