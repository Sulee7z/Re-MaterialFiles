<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activityDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      ~ Responsive dual-pane content (Ghost Commander style): on wide screens (landscape or
      ~ >= 600dp) both panes are shown side by side; on narrow screens only the ACTIVE pane
      ~ is shown and a bottom "switch to the other side" bar appears (like Ghost Commander's
      ~ sxs mode toggling). The active pane is highlighted by its title bar color
      ~ (highlightCurrentTitle). The shared top bar (search/sort/three dots) sits above both
      ~ panes; the FAB is fixed at the bottom-right. The navigation drawer is hosted by this
      ~ full-screen DrawerLayout so it draws over the divider and the right pane.
      -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/sharedTopBarFrame"
                android:layout_width="match_parent"
                android:layout_height="?actionBarSize"
                android:background="?colorAppBarSurface">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/sharedToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?colorAppBarSurface"
                    android:theme="?actionBarTheme"
                    app:popupTheme="?actionBarPopupTheme"
                    tools:ignore="MissingClass" />

                <!--
                  ~ The shared multi-select action bar: rendered in the SAME top bar layer as
                  ~ the three-line menu button (overlaying the search/sort/three-dots items).
                  ~ When files are selected in either pane, this bar replaces the top-bar
                  ~ items with: delete, copy (original icons), copy-to-other-pane and
                  ~ cut-to-other-pane (dedicated icons).
                  -->
                <me.zhanghai.android.files.ui.OverlayToolbar
                    android:id="@+id/sharedOverlayToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?colorAppBarSurface"
                    android:visibility="gone"
                    app:popupTheme="?actionBarPopupTheme" />
            </FrameLayout>

            <!--
              ~ The shared breadcrumb bar, MT Manager style: fixed directly under the top
              ~ bar (never scrolls away), it always shows the path of the ACTIVE pane and
              ~ switches together with the active pane. The per-pane breadcrumb bars are
              ~ hidden in two-pane mode.
              -->
            <me.zhanghai.android.files.filelist.BreadcrumbLayout
                android:id="@+id/sharedBreadcrumbLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?colorAppBarSurface"
                android:paddingStart="@dimen/content_start_margin_minus_12dp"
                android:paddingEnd="@dimen/screen_edge_margin_minus_12dp" />

            <LinearLayout
                android:id="@+id/paneRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="horizontal">

                <!--
                  ~ Each pane is a file-list container. The per-pane path display is the
                  ~ fragment's own breadcrumb bar (same component as single-pane mode); the
                  ~ active pane is marked by a raised elevation shadow overlaying the divider
                  ~ and the dimmed inactive pane.
                  ~ Fixed ids so FragmentManager can restore the two FileListFragments across
                  ~ Activity recreation. Pane widths are set in code (no layout weights):
                  ~ DrawerLayout (the FileListFragment root) crashes when a weight-based
                  ~ LinearLayout measures it with AT_MOST.
                  -->
                <FrameLayout
                    android:id="@+id/leftPane"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    tools:ignore="Suspicious0dp">

                    <FrameLayout
                        android:id="@+id/leftPaneContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Shadow cast by the ACTIVE (right) pane onto the inactive left
                         pane's divider side; fades out to the left, MT Manager style. -->
                    <View
                        android:id="@+id/leftPaneShadow"
                        android:layout_width="@dimen/two_pane_shadow_width"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:background="@drawable/two_pane_shadow_right_to_left"
                        android:visibility="gone" />
                </FrameLayout>

                <View
                    android:id="@+id/divider"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/two_pane_divider" />

                <FrameLayout
                    android:id="@+id/rightPane"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    tools:ignore="Suspicious0dp">

                    <FrameLayout
                        android:id="@+id/rightPaneContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Shadow cast by the ACTIVE (left) pane onto the inactive right
                         pane's divider side; fades out to the right, MT Manager style. -->
                    <View
                        android:id="@+id/rightPaneShadow"
                        android:layout_width="@dimen/two_pane_shadow_width"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="@drawable/two_pane_shadow_left_to_right"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Paste bar (two-pane): shown when the shared clipboard holds entries; its
             paste action targets the ACTIVE pane. The FAB shifts up above it while it
             is visible. -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/bottomToolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:layout_gravity="bottom"
            android:background="?colorSurface"
            android:elevation="@dimen/design_appbar_elevation"
            android:fitsSystemWindows="true"
            android:theme="?actionBarTheme"
            android:visibility="gone"
            app:navigationIcon="@drawable/close_icon_control_normal_24dp"
            app:navigationContentDescription="@string/close"
            app:popupTheme="?actionBarPopupTheme" />

        <com.leinardi.android.speeddial.SpeedDialOverlayLayout
            android:id="@+id/fabBgView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true" />

        <me.zhanghai.android.files.ui.ThemedSpeedDialView
            android:id="@+id/floatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/screen_edge_margin_minus_16dp"
            app:sdMainFabAnimationRotateAngle="135"
            app:sdMainFabClosedSrc="@drawable/add_icon_white_24dp"
            app:sdOverlayLayout="@id/fabBgView" />
    </FrameLayout>

    <!--
      ~ The navigation drawer lives at the Activity level (full-screen DrawerLayout), so it
      ~ opens over the divider and the right pane exactly like the single-pane drawer.
      ~ Content width is 65% of the screen; the drawer background covers the rest.
      -->
    <me.zhanghai.android.files.ui.NavigationFrameLayout
        android:id="@+id/activityNavigationFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?colorSurface"
        android:fitsSystemWindows="true">
    </me.zhanghai.android.files.ui.NavigationFrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
