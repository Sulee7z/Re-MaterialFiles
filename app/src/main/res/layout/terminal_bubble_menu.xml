<?xml version="1.0" encoding="utf-8"?>

<!-- Menu shown when the terminal bubble is tapped: return to the running terminal,
     hide it (session keeps running), or close it completely. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/terminal_bubble_menu_background"
    android:elevation="8dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/terminalBubbleReturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/terminal_bubble_return"
        android:textColor="@color/terminal_bubble_menu_text"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_bubble_menu_divider" />

    <TextView
        android:id="@+id/terminalBubbleHide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/terminal_bubble_hide"
        android:textColor="@color/terminal_bubble_menu_text"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_bubble_menu_divider" />

    <TextView
        android:id="@+id/terminalBubbleClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/terminal_bubble_close"
        android:textColor="@color/terminal_bubble_menu_text"
        android:textSize="14sp" />
</LinearLayout>
