<?xml version="1.0" encoding="utf-8"?>

<!--
  ~ Two-pane active-pane marker, Material 3 style: a small, very soft shadow that
  ~ fades out smoothly from the divider (left edge, the active pane side) toward the
  ~ right, like a subtle M3 surface elevation shadow. Used on the INACTIVE pane's
  ~ left edge.
  -->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerX="0.25"
        android:startColor="@color/two_pane_shadow_start"
        android:centerColor="@color/two_pane_shadow_center"
        android:endColor="@color/two_pane_shadow_end" />
</shape>
