<?xml version="1.0" encoding="utf-8"?>

<!--
  ~ Two-pane divider: a wide (grab-friendly) draggable handle that draws a 1dp line in
  ~ its center. The extra transparent width is the drag touch target. A rounded
  ~ "grabber" capsule sits in the middle so users can see it is draggable.
  -->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="1dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutline" />
        </shape>
    </item>
    <item
        android:width="4dp"
        android:height="24dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="?attr/colorOnSurfaceVariant" />
        </shape>
    </item>
</layer-list>
