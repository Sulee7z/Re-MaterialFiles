<?xml version="1.0" encoding="utf-8"?>

<!--
  ~ Two-pane divider handle: a vertical rounded "pill", styled after the Android
  ~ gesture-navigation bar. Hidden by default; shown while resizing the panes.
  ~ Theme-adaptive: colorOnSurface is near-black in light mode (like the dark
  ~ gesture bar on light backgrounds) and white in dark mode; the item alpha
  ~ keeps it slightly translucent at rest.
  -->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="4dp"
        android:height="32dp"
        android:gravity="center"
        android:alpha="0.66">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="?attr/colorOnSurface" />
        </shape>
    </item>
</layer-list>
