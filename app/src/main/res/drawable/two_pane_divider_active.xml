<?xml version="1.0" encoding="utf-8"?>

<!--
  ~ Two-pane divider handle while being dragged: the gesture-bar pill turns fully
  ~ opaque (colorOnSurface at full strength: solid black in light mode, solid
  ~ white in dark mode), so the user can clearly see the handle is active.
  -->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="4dp"
        android:height="32dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="?attr/colorOnSurface" />
        </shape>
    </item>
</layer-list>
