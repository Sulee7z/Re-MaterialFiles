<?xml version="1.0" encoding="utf-8"?>

<!-- Material 3 surface (light mode), hardcoded because the menu is inflated from the
     application context whose theme is the M2 manifest theme, where theme attributes
     resolve to transparent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFF7F2FA" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#1F1D1B" />
</shape>
